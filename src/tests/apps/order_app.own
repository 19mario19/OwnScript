type Result<T, E> = Ok(T) | Err(E)

fn check(value: number) -> Result<number, string> {
    if value > 0 {
        return Ok(value)
    }

    return Err("invalid")
}

let result = check(10)

match result {
    Ok(value) => {
        return value
    }

    Err(message) => {
        return 0
    }
}
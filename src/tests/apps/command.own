type Result<T,E> = Ok(T) | Err(E)
type Command = Add(number,number) | Mul(number,number) | Sub(number,number) | Div(number,number) | Quit
`
fn execute(&command: Command)-> Result<number, string>{
    let result = match command {
        Command::Add(a, b)=> {
            return Result::Ok(a+b)
        }
        Command::Mul(a, b)=> {
            return Result::Ok(a*b)
        }
        Command::Sub(a, b)=> {
            return Result::Ok(a-b)
        }
        Command::Div(a, b)=> {
            return Result::Ok(a/b)
        }
        Command::Quit=> {
            return Result::Err("Quit!")
        }
    }

    return result
}

fn main(){

    let command = Command::Add(10, 10)

    let result = match execute(&command) {
        Result::Ok(res) => {
            return res
        } 
        Result::Err(err)=> {
            return 0
        }
    }


}

main()
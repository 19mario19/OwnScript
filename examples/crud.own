struct Request {
    method: string,
    path: string,
    body: string
}

struct Response {
    status: number,
    mut body: string
}

struct User {
    id: number,
    mut name: string,
    mut email: string
}

fn startServer(port: number, handler: |&Request| -> Response) {
    unsafe {
        import('http').then(({ default: http }) => {
            const server = http.createServer((req, res) => {
                let chunks = []
                req.on('data', chunk => chunks.push(chunk))
                req.on('end', () => {
                    const body = Buffer.concat(chunks).toString()
                    const request = new Request(req.method, req.url, body)
                    const response = handler(request)
                    res.writeHead(response.status, {'Content-Type': 'application/json'})
                    res.end(response.body)
                })
            })
            server.listen(port)
        })
    }
}

fn createUser(id: number, name: string, email: string) -> User {
    return User{id: id, name: name, email: email}
}

fn handleRequest(&req: Request) -> Response {
   unsafe {
        if (req.method === 'POST' && req.path === '/users') {
            const data = JSON.parse(req.body)
            const user = createUser(1, data.name, data.email)
            return new Response(201, JSON.stringify(user))
        }
        return new Response(404, JSON.stringify({ error: 'not found' }))
    }
}

startServer(3000, handleRequest)
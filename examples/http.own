pub async fn get(&URL: string){
   return async unsafe {
        let res = await fetch(URL)
        let json = await res.json()
        return json
    }
    
}

pub async fn post(&URL: string, &body){
    return async unsafe {
        let res = await fetch(URL, 
        {
            method: "POST",
            body: JSON.stringify(body)
            }
        )
        let json = await res.json()
        return json
    }
}


async fn main(){
    let POST_URL = "https://jsonplaceholder.typicode.com/posts/"
    let posts <- get(&POST_URL)
}
main()
type Result<T, E> = Ok(T) | Err(E)

fn getUser(id: number) -> Result<number, string> {
    if id > 0 {
        return Result::Ok(id)
    }
    return Result::Err("not found")
}

let result = match getUser(1) {
    Result::Ok(x) => {
        return x
    }
    Result::Err(e) => {
        return 0
    }
}
